<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<!-- Configuración de Spring Boot como proyecto padre. Define versiones compatibles para todas las dependencias. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.ejercicio4</groupId>
	<artifactId>mvc</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Ejercicio4 MVC</name>
	<description>Proyecto Spring Boot MVC para el Ejercicio 4</description>

	<properties>
		<!-- Especificamos Java 17 como requisito para compilar y ejecutar el proyecto -->
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<!-- 
			Spring Web (Starter): 
			Proporciona las herramientas necesarias para construir aplicaciones web y APIs RESTful. 
			Incluye Tomcat como servidor embebido por defecto y Spring MVC para la capa de controladores y ruteo HTTP.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- 
			Thymeleaf (Starter): 
			Motor de plantillas para Java que se integra perfectamente con Spring MVC.
			Permite renderizar vistas HTML dinámicas del lado del servidor, inyectando datos desde los controladores hacia el HTML.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- 
			Spring Data JPA (Starter): 
			Simplifica la implementación de la capa de acceso a datos utilizando JPA (Java Persistence API).
			Incluye Hibernate como implementación por defecto (ORM) y permite realizar operaciones CRUD interactuando con objetos de Java en lugar de SQL directo.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- 
			Validation (Starter): 
			Proporciona soporte para la validación de JavaBeans (JSR-380), a través de anotaciones como @NotNull, @Size, @Email, etc.
			Es fundamental para validar los datos que ingresan a través de formularios en los controladores y para asegurar la integridad de datos en la capa de servicios.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- 
			MySQL Driver: 
			El controlador JDBC necesario para que nuestra aplicación Java pueda conectarse y comunicarse con el servidor de base de datos MySQL.
			Scope 'runtime' indica que no se necesita para compilar el código, pero es esencial al ejecutar la aplicación.
		-->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- 
			Spring Boot Starter Test: 
			Incluye librerías esenciales para realizar pruebas unitarias y de integración (JUnit, Mockito, etc.). 
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Plugin de Spring Boot para empaquetar la aplicación como un JAR ejecutable (incluyendo todas las dependencias y el servidor Tomcat) -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
